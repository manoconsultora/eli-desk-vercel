language js

or {
  JsForStatement(),
  JsForInStatement(),
  JsForOfStatement(),
  JsWhileStatement(),
  JsDoWhileStatement()
} as $loop where {
  not $loop <: r"(?s)for await.*",
  not $loop <: contains `await $_` until or {
    JsArrowFunctionExpression(),
    JsFunctionExpression(),
    JsFunctionDeclaration(),
    JsMethodObjectMember()
  },
  register_diagnostic(span=$loop, message="Usá filter/map/reduce en lugar de un loop. Un loop solo va si espera (await) en cada vuelta.", severity="error")
}
